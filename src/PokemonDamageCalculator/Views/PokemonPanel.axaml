<UserControl
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PokemonDamageCalculator.Views.PokemonPanel">

        <StackPanel>
                <!-- Pokemon UI Template -->
                <StackPanel Grid.Column="0" 
                        HorizontalAlignment="Center"
                        Spacing="10">

                        <TextBlock Text="Select Pokemon"
                                FontSize="32"
                                HorizontalAlignment="Center"
                                FontWeight="Bold"/>

                        <!-- Choose Pokemon 1 -->
                        <AutoCompleteBox x:Name="PokemonAcb"
                                        HorizontalAlignment="Center"
                                        ValueMemberBinding="{ReflectionBinding Name}"
                                        FilterMode="Contains"
                                        MinimumPrefixLength="1"
                                        PlaceholderText="Search..."
                                        FontSize="24"
                                        Width="225">

                                        <AutoCompleteBox.Styles>
                                                <Style Selector="TextBox">
                                                        <Setter Property="TextAlignment" Value="Center" />
                                                </Style>
                                        </AutoCompleteBox.Styles>
                        </AutoCompleteBox>

                        <Button x:Name="Move1Button"
                                Content="- Move 1 -"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Margin="0,0,0,-10"
                                MinWidth="200"
                                MaxWidth="200"/>

                        <Button x:Name="Move2Button"
                                Content="- Move 2 -"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Margin="0,0,0,-10"
                                MinWidth="200"
                                MaxWidth="200"/>

                        <Button x:Name="Move3Button"
                                Content="- Move 3 -"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Margin="0,0,0,-10"
                                MinWidth="200"
                                MaxWidth="200"/>

                        <Button x:Name="Move4Button"
                                Content="- Move 4 -"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                MinWidth="200"
                                MaxWidth="200"/>

                        <Border BorderBrush="#ffffff"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Width="400">
                                <StackPanel>
                                        <TextBlock Text="Edit Moves"
                                                HorizontalAlignment="Center"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Margin="0,0,0,5"/>

                                        <Grid ColumnDefinitions="*,1.75*">
                                                <!-- Move Selection -->
                                                <StackPanel Grid.Column="0"
                                                                Spacing="10"
                                                                HorizontalAlignment="Right">

                                                        <AutoCompleteBox x:Name="Move1Acb"
                                                                        HorizontalAlignment="Center"
                                                                        Margin="0,0,0,-10"
                                                                        ValueMemberBinding="{ReflectionBinding Name}"
                                                                        FilterMode="Contains"
                                                                        MinimumPrefixLength="1"
                                                                        PlaceholderText="Search..."
                                                                        MinWidth="125"
                                                                        MaxWidth="125">
                                                        </AutoCompleteBox>

                                                        <AutoCompleteBox x:Name="Move2Acb"
                                                                        HorizontalAlignment="Center"
                                                                        Margin="0,0,0,-10"
                                                                        ValueMemberBinding="{ReflectionBinding Name}"
                                                                        FilterMode="Contains"
                                                                        MinimumPrefixLength="1"
                                                                        PlaceholderText="Search..."
                                                                        MinWidth="125"
                                                                        MaxWidth="125">
                                                        </AutoCompleteBox>

                                                        <AutoCompleteBox x:Name="Move3Acb"
                                                                        HorizontalAlignment="Center"
                                                                        Margin="0,0,0,-10"
                                                                        ValueMemberBinding="{ReflectionBinding Name}"
                                                                        FilterMode="Contains"
                                                                        MinimumPrefixLength="1"
                                                                        PlaceholderText="Search..."
                                                                        MinWidth="125"
                                                                        MaxWidth="125">
                                                        </AutoCompleteBox>

                                                        <AutoCompleteBox x:Name="Move4Acb"
                                                                        HorizontalAlignment="Center"
                                                                        ValueMemberBinding="{ReflectionBinding Name}"
                                                                        FilterMode="Contains"
                                                                        MinimumPrefixLength="1"
                                                                        PlaceholderText="Search..."
                                                                        MinWidth="125"
                                                                        MaxWidth="125">
                                                        </AutoCompleteBox>
                                                </StackPanel>

                                                <!-- Move Info -->
                                                <StackPanel Grid.Column="1"
                                                                Spacing="13"
                                                                Margin="10,0,0,0"
                                                                HorizontalAlignment="Left">

                                                        <TextBlock x:Name="Move1Info"
                                                                        Text="Move Info..."
                                                                        FontSize="14"
                                                                        Margin="0,8,0,0"
                                                                        MaxWidth="266"/>

                                                        <TextBlock x:Name="Move2Info"
                                                                        Text="Move Info..."
                                                                        FontSize="14"
                                                                        MaxWidth="266"/>

                                                        <TextBlock x:Name="Move3Info"
                                                                        Text="Move Info..."
                                                                        FontSize="14"
                                                                        MaxWidth="266"/>

                                                        <TextBlock x:Name="Move4Info"
                                                                        Text="Move Info..."
                                                                        FontSize="14"
                                                                        MaxWidth="266"/>
                                                </StackPanel>
                                        </Grid>
                                </StackPanel>
                        </Border>

                        <Border BorderBrush="#ffffff"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Width="400">
                                <StackPanel>
                                        <TextBlock Text="Edit Stats"
                                                HorizontalAlignment="Center"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Margin="0,0,0,5"/>

                                        <!-- Pokemon level selection -->
                                        <Grid ColumnDefinitions="*,*"
                                                HorizontalAlignment="Center"
                                                ColumnSpacing="10"
                                                Margin="-15,0,0,0">

                                                <TextBlock Grid.Column="0"
                                                                Text="Level:"
                                                                FontSize="14"
                                                                VerticalAlignment="Center"/>

                                                <!-- Create textbox (dont forget to add lostfocus)-->
                                                <TextBox x:Name="LevelTextBox"
                                                        LostFocus="LevelTextBox_LostFocus"
                                                        HorizontalAlignment="Center"
                                                        Grid.Column="1"
                                                        Text="50"
                                                        FontSize="16"
                                                        MaxLength="3"
                                                        MaxLines="1"
                                                        Height="30"
                                                        MinWidth="0"
                                                        Width="52"
                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                                                HorizontalAlignment="Center"
                                                ColumnSpacing="10"
                                                Margin="-15,0,0,0">

                                                <!-- Info Column -->
                                                <StackPanel Grid.Column="0"
                                                        Spacing="11"
                                                        Margin="0,4,0,0">

                                                        <TextBlock Text=""
                                                                HorizontalAlignment="Right"/>
                                                        
                                                        <TextBlock Text="HP"
                                                                HorizontalAlignment="Right"/>

                                                        <TextBlock Text="Atk"
                                                                HorizontalAlignment="Right"/>

                                                        <TextBlock Text="Def"
                                                                HorizontalAlignment="Right"/>

                                                        <TextBlock Text="SpAtk"
                                                                HorizontalAlignment="Right"/>

                                                        <TextBlock Text="SpDef"
                                                                HorizontalAlignment="Right"/>

                                                        <TextBlock Text="Speed"
                                                                HorizontalAlignment="Right"/>
                                                
                                                </StackPanel>

                                                <!-- IV Column -->
                                                <StackPanel Grid.Column="1"
                                                        Spacing="0">

                                                        <TextBlock Text="IVs"
                                                                HorizontalAlignment="Center"
                                                                Margin="0,5,0,5"/>
                                                        
                                                        <!-- HP -->
                                                        <TextBox x:Name="HpIVTextBox"
                                                                        LostFocus="HpIVTextBox_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        Grid.Column="1"
                                                                        Text="31"
                                                                        FontSize="16"
                                                                        MaxLength="3"
                                                                        MaxLines="1"
                                                                        Height="30"
                                                                        MinWidth="0"
                                                                        Width="40"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                                        <!-- Atk -->
                                                        <TextBox x:Name="AtkIVTextBox"
                                                                        LostFocus="AtkIVTextBox_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        Grid.Column="1"
                                                                        Text="31"
                                                                        FontSize="16"
                                                                        MaxLength="3"
                                                                        MaxLines="1"
                                                                        Height="30"
                                                                        MinWidth="0"
                                                                        Width="40"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                                        <!-- Def -->
                                                        <TextBox x:Name="DefIVTextBox"
                                                                        LostFocus="DefIVTextBox_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        Grid.Column="1"
                                                                        Text="31"
                                                                        FontSize="16"
                                                                        MaxLength="3"
                                                                        MaxLines="1"
                                                                        Height="30"
                                                                        MinWidth="0"
                                                                        Width="40"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                                        <!-- SpAtk -->
                                                        <TextBox x:Name="SpAtkIVTextBox"
                                                                        LostFocus="SpAtkIVTextBox_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        Grid.Column="1"
                                                                        Text="31"
                                                                        FontSize="16"
                                                                        MaxLength="3"
                                                                        MaxLines="1"
                                                                        Height="30"
                                                                        MinWidth="0"
                                                                        Width="40"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                                        <!-- SpDef -->
                                                        <TextBox x:Name="SpDefIVTextBox"
                                                                        LostFocus="SpDefIVTextBox_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        Grid.Column="1"
                                                                        Text="31"
                                                                        FontSize="16"
                                                                        MaxLength="3"
                                                                        MaxLines="1"
                                                                        Height="30"
                                                                        MinWidth="0"
                                                                        Width="40"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                                        <!-- Speed -->
                                                        <TextBox x:Name="SpeedIVTextBox"
                                                                        LostFocus="SpeedIVTextBox_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        Grid.Column="1"
                                                                        Text="31"
                                                                        FontSize="16"
                                                                        MaxLength="3"
                                                                        MaxLines="1"
                                                                        Height="30"
                                                                        MinWidth="0"
                                                                        Width="40"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                                                        
                                                </StackPanel>

                                                <!-- EV Column -->
                                                <StackPanel Grid.Column="2"
                                                        Spacing="0">

                                                        <TextBlock Text="EVs"
                                                                HorizontalAlignment="Center"
                                                                Margin="0,5,0,5"/>
                                                        
                                                        <!-- HP -->
                                                        <TextBox x:Name="HpEVTextBox"
                                                                        LostFocus="HpEVTextBox_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        Grid.Column="1"
                                                                        Text="0"
                                                                        FontSize="16"
                                                                        MaxLength="4"
                                                                        MaxLines="1"
                                                                        Height="30"
                                                                        MinWidth="0"
                                                                        Width="52"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                                        <!-- Atk -->
                                                        <TextBox x:Name="AtkEVTextBox"
                                                                        LostFocus="AtkEVTextBox_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        Grid.Column="1"
                                                                        Text="0"
                                                                        FontSize="16"
                                                                        MaxLength="4"
                                                                        MaxLines="1"
                                                                        Height="30"
                                                                        MinWidth="0"
                                                                        Width="52"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                                        <!-- Def -->
                                                        <TextBox x:Name="DefEVTextBox"
                                                                        LostFocus="DefEVTextBox_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        Grid.Column="1"
                                                                        Text="0"
                                                                        FontSize="16"
                                                                        MaxLength="4"
                                                                        MaxLines="1"
                                                                        Height="30"
                                                                        MinWidth="0"
                                                                        Width="52"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                                        <!-- SpAtk -->
                                                        <TextBox x:Name="SpAtkEVTextBox"
                                                                        LostFocus="SpAtkEVTextBox_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        Grid.Column="1"
                                                                        Text="0"
                                                                        FontSize="16"
                                                                        MaxLength="4"
                                                                        MaxLines="1"
                                                                        Height="30"
                                                                        MinWidth="0"
                                                                        Width="52"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                                        <!-- SpDef -->
                                                        <TextBox x:Name="SpDefEVTextBox"
                                                                        LostFocus="SpDefEVTextBox_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        Grid.Column="1"
                                                                        Text="0"
                                                                        FontSize="16"
                                                                        MaxLength="4"
                                                                        MaxLines="1"
                                                                        Height="30"
                                                                        MinWidth="0"
                                                                        Width="52"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                                        <!-- Speed -->
                                                        <TextBox x:Name="SpeedEVTextBox"
                                                                        LostFocus="SpeedEVTextBox_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        Grid.Column="1"
                                                                        Text="0"
                                                                        FontSize="16"
                                                                        MaxLength="4"
                                                                        MaxLines="1"
                                                                        Height="30"
                                                                        MinWidth="0"
                                                                        Width="52"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                                        <!-- Display total EVs -->
                                                        <TextBlock x:Name="EVDisplay"
                                                                        HorizontalAlignment="Center"
                                                                        Text="0/510"
                                                                        FontSize="13"/>
                                                        
                                                </StackPanel>

                                                <!-- Base Stat Column -->
                                                <StackPanel Grid.Column="3"
                                                        Spacing="11"
                                                        Margin="0,4,0,0">

                                                        <TextBlock Text="Base"
                                                                HorizontalAlignment="Center"/>
                                                        
                                                        <TextBlock x:Name="BaseHPText"
                                                                Text="-"
                                                                HorizontalAlignment="Center"/>

                                                        <TextBlock x:Name="BaseAtkText"
                                                                Text="-"
                                                                HorizontalAlignment="Center"/>

                                                        <TextBlock x:Name="BaseDefText"
                                                                Text="-"
                                                                HorizontalAlignment="Center"/>

                                                        <TextBlock x:Name="BaseSpAtkText"
                                                                Text="-"
                                                                HorizontalAlignment="Center"/>

                                                        <TextBlock x:Name="BaseSpDefText"
                                                                Text="-"
                                                                HorizontalAlignment="Center"/>

                                                        <TextBlock x:Name="BaseSpeedText"
                                                                Text="-"
                                                                HorizontalAlignment="Center"/>
                                                
                                                </StackPanel>
                                        </Grid>
                                </StackPanel>
                        </Border>

                        <Border BorderBrush="#ffffff"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Width="400">
                                <StackPanel>
                                        <TextBlock Text="Other"
                                                HorizontalAlignment="Center"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Margin="0,0,0,5"/>

                                        <Grid ColumnDefinitions="*,2*">

                                                <!-- Stackpanel with labels for autocompleteboxes-->
                                                <StackPanel Grid.Column="0"
                                                        HorizontalAlignment="Right"
                                                        Spacing="13"
                                                        Margin="0,6,10,0">
                                                        
                                                        <TextBlock Text="Nature"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right"/>

                                                        <TextBlock Text="Ability"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right"/>
                                                        
                                                        <TextBlock Text="Held Item"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right"/>

                                                        <TextBlock Text="Status"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right"/>

                                                        <TextBlock Text="Gender"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right"/>
                                                </StackPanel>

                                                <!-- Stackpanel with autocompleteboxes-->
                                                <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Left">
                                                        
                                                        <!-- Nature selection -->
                                                        <AutoCompleteBox x:Name="NatureAcb"
                                                                        LostFocus="NatureAcb_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        FilterMode="Contains"
                                                                        MinimumPrefixLength="1"
                                                                        PlaceholderText="Search..."
                                                                        MinWidth="125"
                                                                        MaxWidth="125">
                                                        </AutoCompleteBox>

                                                        <!-- Ability selection -->
                                                        <AutoCompleteBox x:Name="AbilityAcb"
                                                                        LostFocus="AbilityAcb_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        FilterMode="Contains"
                                                                        MinimumPrefixLength="1"
                                                                        PlaceholderText="Search..."
                                                                        MinWidth="125"
                                                                        MaxWidth="125">
                                                        </AutoCompleteBox>

                                                        <!-- Held item selection -->
                                                        <AutoCompleteBox x:Name="ItemAcb"
                                                                        LostFocus="ItemAcb_LostFocus"
                                                                        HorizontalAlignment="Center"
                                                                        FilterMode="Contains"
                                                                        MinimumPrefixLength="1"
                                                                        PlaceholderText="Search..."
                                                                        MinWidth="125"
                                                                        MaxWidth="125">
                                                        </AutoCompleteBox>

                                                        <!-- Status selection -->
                                                        <ComboBox x:Name="StatusCb"
                                                                HorizontalAlignment="Center"
                                                                PlaceholderText="Select..."
                                                                MinWidth="125"
                                                                MaxWidth="125"
                                                                SelectedIndex="0">

                                                                <ComboBoxItem Content="Healthy"/>
                                                                <ComboBoxItem Content="Burned"/>
                                                                <ComboBoxItem Content="Paralyzed"/>
                                                                <ComboBoxItem Content="Poisoned"/>
                                                                <ComboBoxItem Content="Badly Poisoned"/>
                                                                <ComboBoxItem Content="Asleep"/>
                                                                <ComboBoxItem Content="Frozen"/>
                                                        </ComboBox>

                                                        <!-- Gender selection -->
                                                        <ComboBox x:Name="GenderCb"
                                                                HorizontalAlignment="Center"
                                                                PlaceholderText="Select..."
                                                                MinWidth="125"
                                                                MaxWidth="125"
                                                                SelectedIndex="0">

                                                                <ComboBoxItem Content="None"/>
                                                                <ComboBoxItem Content="Male"/>
                                                                <ComboBoxItem Content="Female"/>
                                                        </ComboBox>
                                                </StackPanel>
                                        </Grid>

                                        <!-- Current HP Selection -->
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                                Margin="0,20,0,0"
                                                HorizontalAlignment="Center">
                                                <TextBlock Grid.Column="0"
                                                        Text="Current HP:"
                                                        FontSize="16"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,0,10,0"/>

                                                <!-- textbox for editing EXACT current HP TODO: LostFocus="CurrentHPTextBox_LostFocus" -->
                                                <TextBox x:Name="CurrentHPTextBox"
                                                        VerticalContentAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Grid.Column="1"
                                                        Text="1"
                                                        FontSize="16"
                                                        MaxLines="1"
                                                        Height="30"
                                                        MinWidth="45"
                                                        MaxWidth="100"
                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                                <TextBlock x:Name="MaxHPText"
                                                        Grid.Column="2"
                                                        Text="/1   ("
                                                        FontSize="16"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"/>

                                                <!-- textbox for editing PERCENT of current HP TODO: LostFocus="PercHPTextBox1_LostFocus" -->
                                                <TextBox x:Name="PercHPTextBox"
                                                        VerticalContentAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Grid.Column="3"
                                                        Text="100"
                                                        FontSize="16"
                                                        MaxLength="4"
                                                        MaxLines="1"
                                                        Height="30"
                                                        MinWidth="0"
                                                        Width="45"
                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                                                
                                                <TextBlock Grid.Column="4"
                                                        Text="%)"
                                                        FontSize="16"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"/>
                                        </Grid>

                                        <!-- Current HP Slider (not mutable, only for display)-->
                                        <Slider x:Name="HpSlider"
                                                        Grid.Column="5"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        Value="1"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        IsHitTestVisible="False">
                                                        
                                                <Slider.Styles>
                                                        <!-- slider dimensions -->
                                                        <Style Selector="Slider:horizontal">
                                                                <Setter Property="MinWidth" Value="300"/>
                                                                <Setter Property="MaxWidth" Value="300"/>
                                                                <Setter Property="Background" Value="Red"/>
                                                                <Setter Property="Foreground" Value="Green"/>
                                                        </Style>

                                                        <!-- filled portion always green -->
                                                        <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton">
                                                                <Setter Property="Background" Value="Green"/>
                                                        </Style>

                                                        <!-- nfilled portion always red -->
                                                        <Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton">
                                                                <Setter Property="Background" Value="Red"/>
                                                        </Style>

                                                        <!-- keep the filled portion green on hover -->
                                                        <Style Selector="Slider:horizontal:pointerover /template/ RepeatButton#PART_DecreaseButton">
                                                                <Setter Property="Background" Value="Green"/>
                                                        </Style>

                                                        <!-- keep the unfilled portion red on hover -->
                                                        <Style Selector="Slider:horizontal:pointerover /template/ RepeatButton#PART_IncreaseButton">
                                                                <Setter Property="Background" Value="Red"/>
                                                        </Style>

                                                        <!-- keep both colors when pressed -->
                                                        <Style Selector="Slider:horizontal:pressed /template/ RepeatButton#PART_DecreaseButton">
                                                                <Setter Property="Background" Value="Green"/>
                                                        </Style>

                                                        <Style Selector="Slider:horizontal:pressed /template/ RepeatButton#PART_IncreaseButton">
                                                                <Setter Property="Background" Value="Red"/>
                                                        </Style>

                                                        <!-- customize the track borders -->
                                                        <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton Border">
                                                                <Setter Property="Height" Value="6"/>
                                                                <Setter Property="CornerRadius" Value="0"/>
                                                        </Style>

                                                        <Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton Border">
                                                                <Setter Property="Height" Value="6"/>
                                                                <Setter Property="CornerRadius" Value="0"/>
                                                        </Style>

                                                        <!-- customize thumb -->
                                                        <Style Selector="Slider:horizontal /template/ Thumb">
                                                                <Setter Property="Height" Value="11"/>
                                                                <Setter Property="Width" Value="11"/>
                                                                <Setter Property="BorderBrush" Value="Green"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Background" Value="Green"/>
                                                        </Style>

                                                        <!-- maintain thumb appearance on hover -->
                                                        <Style Selector="Slider:horizontal:pointerover /template/ Thumb">
                                                                <Setter Property="Background" Value="Green"/>
                                                                <Setter Property="BorderBrush" Value="Green"/>
                                                        </Style>
                                                </Slider.Styles>
                                        </Slider>
                                </StackPanel>
                        </Border>
                </StackPanel>
        </StackPanel>
</UserControl>