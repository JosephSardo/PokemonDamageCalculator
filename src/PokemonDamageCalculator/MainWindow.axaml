<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PokemonDamageCalculator.MainWindow"
        Title="PokemonDamageCalculator"
        Width="1100"
        Height="1100"
        CanResize="False">

        <Grid ColumnDefinitions="*,*,*">

            <!-- Pokemon1 -->
            <StackPanel Grid.Column="0" 
                        HorizontalAlignment="Center"
                        Spacing="10">

                <TextBlock Text="Pokemon 1"
                            FontSize="32"
                            HorizontalAlignment="Center"
                            FontWeight="Bold"/>

                <!-- Choose Pokemon 1 -->
                <AutoCompleteBox x:Name="Pokemon1acb"
                                HorizontalAlignment="Center"
                                ValueMemberBinding="{ReflectionBinding Name}"
                                FilterMode="Contains"
                                MinimumPrefixLength="1"
                                PlaceholderText="Search Pokemon...">
                </AutoCompleteBox>

                <Button x:Name="P1move1button"
                        Content="- Move 1 -"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,0,-10"
                        MinWidth="125"
                        MaxWidth="125"/>

                <Button x:Name="P1move2button"
                        Content="- Move 2 -"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,0,-10"
                        MinWidth="125"
                        MaxWidth="125"/>

                <Button x:Name="P1move3button"
                        Content="- Move 3 -"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,0,-10"
                        MinWidth="125"
                        MaxWidth="125"/>

                <Button x:Name="P1move4button"
                        Content="- Move 4 -"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        MinWidth="125"
                        MaxWidth="125"/>

                <TextBlock Text="Edit Moves"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"/>

                <Grid ColumnDefinitions="*,2*">
                        <!-- Move Selection -->
                        <StackPanel Grid.Column="0"
                                        Spacing="10">

                                <AutoCompleteBox x:Name="P1move1acb"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,-10"
                                                ValueMemberBinding="{ReflectionBinding Name}"
                                                FilterMode="Contains"
                                                MinimumPrefixLength="1"
                                                PlaceholderText="Search Moves..."
                                                MinWidth="125"
                                                MaxWidth="125">
                                </AutoCompleteBox>

                                <AutoCompleteBox x:Name="P1move2acb"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,-10"
                                                ValueMemberBinding="{ReflectionBinding Name}"
                                                FilterMode="Contains"
                                                MinimumPrefixLength="1"
                                                PlaceholderText="Search Moves..."
                                                MinWidth="125"
                                                MaxWidth="125">
                                </AutoCompleteBox>

                                <AutoCompleteBox x:Name="P1move3acb"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,-10"
                                                ValueMemberBinding="{ReflectionBinding Name}"
                                                FilterMode="Contains"
                                                MinimumPrefixLength="1"
                                                PlaceholderText="Search Moves..."
                                                MinWidth="125"
                                                MaxWidth="125">
                                </AutoCompleteBox>

                                <AutoCompleteBox x:Name="P1move4acb"
                                                HorizontalAlignment="Center"
                                                ValueMemberBinding="{ReflectionBinding Name}"
                                                FilterMode="Contains"
                                                MinimumPrefixLength="1"
                                                PlaceholderText="Search Moves..."
                                                MinWidth="125"
                                                MaxWidth="125">
                                </AutoCompleteBox>
                        </StackPanel>

                        <!-- Move Info -->
                        <StackPanel Grid.Column="1"
                                        Spacing="15"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left">

                                <TextBlock x:Name="P1move1info"
                                                Text="Move Info..."
                                                FontSize="14"
                                                Margin="0,8,0,0"/>

                                <TextBlock x:Name="P1move2info"
                                                Text="Move Info..."
                                                FontSize="14"/>

                                <TextBlock x:Name="P1move3info"
                                                Text="Move Info..."
                                                FontSize="14"/>

                                <TextBlock x:Name="P1move4info"
                                                Text="Move Info..."
                                                FontSize="14"/>
                        </StackPanel>
                </Grid>

                <TextBlock Text="Edit Stats"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"/>

                <!-- Pokemon level selection -->
                <Grid ColumnDefinitions="*,*"
                        HorizontalAlignment="Center"
                        ColumnSpacing="10"
                        Margin="-15,0,0,0">

                        <TextBlock Grid.Column="0"
                                        Text="Level:"
                                        FontSize="14"
                                        VerticalAlignment="Center"/>

                        <!-- Create textbox (dont forget to add lostfocus)-->
                        <TextBox x:Name="LevelTextBox1"
                                LostFocus="LevelTextBox1_LostFocus"
                                HorizontalAlignment="Center"
                                Grid.Column="1"
                                Text="50"
                                FontSize="16"
                                MaxLength="3"
                                MaxLines="1"
                                Height="30"
                                MinWidth="0"
                                Width="52"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                        HorizontalAlignment="Center"
                        ColumnSpacing="10"
                        Margin="-15,0,0,0">

                        <!-- Info Column -->
                        <StackPanel Grid.Column="0"
                                Spacing="15"
                                Margin="0,2,0,0">

                                <TextBlock Text=""
                                        HorizontalAlignment="Right"/>
                                
                                <TextBlock Text="HP"
                                        HorizontalAlignment="Right"/>

                                <TextBlock Text="Atk"
                                        HorizontalAlignment="Right"/>

                                <TextBlock Text="Def"
                                        HorizontalAlignment="Right"/>

                                <TextBlock Text="SpAtk"
                                        HorizontalAlignment="Right"/>

                                <TextBlock Text="SpDef"
                                        HorizontalAlignment="Right"/>

                                <TextBlock Text="Speed"
                                        HorizontalAlignment="Right"/>
                        
                        </StackPanel>

                        <!-- IV Column -->
                        <StackPanel Grid.Column="1"
                                Spacing="0">

                                <TextBlock Text="IVs"
                                        HorizontalAlignment="Center"
                                        Margin="0,5,0,5"/>
                                
                                <!-- HP -->
                                <TextBox x:Name="HpIVTextBox1"
                                                LostFocus="HpIVTextBox1_LostFocus"
                                                HorizontalAlignment="Center"
                                                Grid.Column="1"
                                                Text="31"
                                                FontSize="16"
                                                MaxLength="3"
                                                MaxLines="1"
                                                Height="30"
                                                MinWidth="0"
                                                Width="40"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                <!-- Atk -->
                                <TextBox x:Name="AtkIVTextBox1"
                                                LostFocus="AtkIVTextBox1_LostFocus"
                                                HorizontalAlignment="Center"
                                                Grid.Column="1"
                                                Text="31"
                                                FontSize="16"
                                                MaxLength="3"
                                                MaxLines="1"
                                                Height="30"
                                                MinWidth="0"
                                                Width="40"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                <!-- Def -->
                                <TextBox x:Name="DefIVTextBox1"
                                                LostFocus="DefIVTextBox1_LostFocus"
                                                HorizontalAlignment="Center"
                                                Grid.Column="1"
                                                Text="31"
                                                FontSize="16"
                                                MaxLength="3"
                                                MaxLines="1"
                                                Height="30"
                                                MinWidth="0"
                                                Width="40"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                <!-- SpAtk -->
                                <TextBox x:Name="SpAtkIVTextBox1"
                                                LostFocus="SpAtkIVTextBox1_LostFocus"
                                                HorizontalAlignment="Center"
                                                Grid.Column="1"
                                                Text="31"
                                                FontSize="16"
                                                MaxLength="3"
                                                MaxLines="1"
                                                Height="30"
                                                MinWidth="0"
                                                Width="40"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                <!-- SpDef -->
                                <TextBox x:Name="SpDefIVTextBox1"
                                                LostFocus="SpDefIVTextBox1_LostFocus"
                                                HorizontalAlignment="Center"
                                                Grid.Column="1"
                                                Text="31"
                                                FontSize="16"
                                                MaxLength="3"
                                                MaxLines="1"
                                                Height="30"
                                                MinWidth="0"
                                                Width="40"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                <!-- Speed -->
                                <TextBox x:Name="SpeedIVTextBox1"
                                                LostFocus="SpeedIVTextBox1_LostFocus"
                                                HorizontalAlignment="Center"
                                                Grid.Column="1"
                                                Text="31"
                                                FontSize="16"
                                                MaxLength="3"
                                                MaxLines="1"
                                                Height="30"
                                                MinWidth="0"
                                                Width="40"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                                
                        </StackPanel>

                        <!-- EV Column -->
                        <StackPanel Grid.Column="2"
                                Spacing="0">

                                <TextBlock Text="EVs"
                                        HorizontalAlignment="Center"
                                        Margin="0,5,0,5"/>
                                
                                <!-- HP -->
                                <TextBox x:Name="HpEVTextBox1"
                                                LostFocus="HpEVTextBox1_LostFocus"
                                                HorizontalAlignment="Center"
                                                Grid.Column="1"
                                                Text="0"
                                                FontSize="16"
                                                MaxLength="4"
                                                MaxLines="1"
                                                Height="30"
                                                MinWidth="0"
                                                Width="52"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                <!-- Atk -->
                                <TextBox x:Name="AtkEVTextBox1"
                                                LostFocus="AtkEVTextBox1_LostFocus"
                                                HorizontalAlignment="Center"
                                                Grid.Column="1"
                                                Text="0"
                                                FontSize="16"
                                                MaxLength="4"
                                                MaxLines="1"
                                                Height="30"
                                                MinWidth="0"
                                                Width="52"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                <!-- Def -->
                                <TextBox x:Name="DefEVTextBox1"
                                                LostFocus="DefEVTextBox1_LostFocus"
                                                HorizontalAlignment="Center"
                                                Grid.Column="1"
                                                Text="0"
                                                FontSize="16"
                                                MaxLength="4"
                                                MaxLines="1"
                                                Height="30"
                                                MinWidth="0"
                                                Width="52"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                <!-- SpAtk -->
                                <TextBox x:Name="SpAtkEVTextBox1"
                                                LostFocus="SpAtkEVTextBox1_LostFocus"
                                                HorizontalAlignment="Center"
                                                Grid.Column="1"
                                                Text="0"
                                                FontSize="16"
                                                MaxLength="4"
                                                MaxLines="1"
                                                Height="30"
                                                MinWidth="0"
                                                Width="52"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                <!-- SpDef -->
                                <TextBox x:Name="SpDefEVTextBox1"
                                                LostFocus="SpDefEVTextBox1_LostFocus"
                                                HorizontalAlignment="Center"
                                                Grid.Column="1"
                                                Text="0"
                                                FontSize="16"
                                                MaxLength="4"
                                                MaxLines="1"
                                                Height="30"
                                                MinWidth="0"
                                                Width="52"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                <!-- Speed -->
                                <TextBox x:Name="SpeedEVTextBox1"
                                                LostFocus="SpeedEVTextBox1_LostFocus"
                                                HorizontalAlignment="Center"
                                                Grid.Column="1"
                                                Text="0"
                                                FontSize="16"
                                                MaxLength="4"
                                                MaxLines="1"
                                                Height="30"
                                                MinWidth="0"
                                                Width="52"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                                <!-- Display total EVs -->
                                <TextBlock x:Name="EVDisplay1"
                                                HorizontalAlignment="Center"
                                                Text="0/510"
                                                FontSize="13"/>
                                
                        </StackPanel>

                        <!-- Base Stat Column -->
                        <StackPanel Grid.Column="3"
                                Spacing="15"
                                Margin="0,2,0,0">

                                <TextBlock Text="Base"
                                        HorizontalAlignment="Center"/>
                                
                                <TextBlock x:Name="BaseHPText1"
                                        Text="-"
                                        HorizontalAlignment="Center"/>

                                <TextBlock x:Name="BaseAtkText1"
                                        Text="-"
                                        HorizontalAlignment="Center"/>

                                <TextBlock x:Name="BaseDefText1"
                                        Text="-"
                                        HorizontalAlignment="Center"/>

                                <TextBlock x:Name="BaseSpAtkText1"
                                        Text="-"
                                        HorizontalAlignment="Center"/>

                                <TextBlock x:Name="BaseSpDefText1"
                                        Text="-"
                                        HorizontalAlignment="Center"/>

                                <TextBlock x:Name="BaseSpeedText1"
                                        Text="-"
                                        HorizontalAlignment="Center"/>
                        
                        </StackPanel>
                </Grid>

                <TextBlock Text="Other"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"/>

                <Grid ColumnDefinitions="*,2*">

                        <!-- Stackpanel with labels for autocompleteboxes-->
                        <StackPanel Grid.Column="0"
                                HorizontalAlignment="Center"
                                Spacing="15"
                                Margin="0,6,10,0">
                                
                                <TextBlock Text="Nature"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"/>

                                <TextBlock Text="Ability"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"/>
                                
                                <TextBlock Text="Held Item"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"/>

                                <TextBlock Text="Status"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"/>

                                <TextBlock Text="Gender"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"/>
                        </StackPanel>

                        <!-- Stackpanel with autocompleteboxes-->
                        <StackPanel Grid.Column="1"
                                HorizontalAlignment="Left">
                                
                                <!-- Nature selection -->
                                <AutoCompleteBox x:Name="Nature1acb"
                                                HorizontalAlignment="Center"
                                                FilterMode="Contains"
                                                MinimumPrefixLength="1"
                                                PlaceholderText="Search..."
                                                MinWidth="125"
                                                MaxWidth="125">
                                </AutoCompleteBox>

                                <!-- Ability selection -->
                                <AutoCompleteBox x:Name="Ability1acb"
                                                HorizontalAlignment="Center"
                                                FilterMode="Contains"
                                                MinimumPrefixLength="1"
                                                PlaceholderText="Search..."
                                                MinWidth="125"
                                                MaxWidth="125">
                                </AutoCompleteBox>

                                <!-- Held item selection -->
                                <AutoCompleteBox x:Name="Item1acb"
                                                HorizontalAlignment="Center"
                                                FilterMode="Contains"
                                                MinimumPrefixLength="1"
                                                PlaceholderText="Search..."
                                                MinWidth="125"
                                                MaxWidth="125">
                                </AutoCompleteBox>

                                <!-- Status selection -->
                                <AutoCompleteBox x:Name="Status1acb"
                                                HorizontalAlignment="Center"
                                                FilterMode="Contains"
                                                MinimumPrefixLength="1"
                                                PlaceholderText="Search..."
                                                MinWidth="125"
                                                MaxWidth="125">
                                </AutoCompleteBox>

                                <!-- Gender selection -->
                                <ComboBox x:Name="Gender1cb"
                                        HorizontalAlignment="Center"
                                        PlaceholderText="Select..."
                                        MinWidth="125"
                                        MaxWidth="125">

                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="Male"/>
                                        <ComboBoxItem Content="Female"/>
                                </ComboBox>
                        </StackPanel>
                </Grid>

                <!-- Current HP Selection -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center">
                        <TextBlock Grid.Column="0"
                                Text="Current HP:"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="0,0,10,0"/>

                        <!-- textbox for editing EXACT current HP TODO: LostFocus="CurrentHPTextBox1_LostFocus" -->
                        <TextBox x:Name="CurrentHPTextBox1"
                                HorizontalAlignment="Center"
                                Grid.Column="1"
                                Text="0"
                                FontSize="16"
                                MaxLines="1"
                                Height="30"
                                MinWidth="0"
                                Width="60"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                        <TextBlock Grid.Column="2"
                                Text="/1 ("
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>

                        <!-- textbox for editing PERCENT of current HP TODO: LostFocus="PercHPTextBox1_LostFocus" -->
                        <TextBox x:Name="PercHPTextBox1"
                                HorizontalAlignment="Center"
                                Grid.Column="3"
                                Text="0"
                                FontSize="16"
                                MaxLines="1"
                                Height="30"
                                MinWidth="0"
                                Width="52"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                        
                        <TextBlock Grid.Column="4"
                                Text="%)"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                </Grid>

                <!-- Current HP Slider -->
                <Slider x:Name="HpSlider1"
                                Grid.Column="5"
                                Minimum="0"
                                Maximum="1"
                                Value="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                                
                        <Slider.Styles>
                                <!-- slider dimensions -->
                                <Style Selector="Slider:horizontal">
                                        <Setter Property="MinWidth" Value="300"/>
                                        <Setter Property="MaxWidth" Value="300"/>
                                        <Setter Property="Background" Value="Red"/>
                                        <Setter Property="Foreground" Value="Green"/>
                                </Style>

                                <!-- filled portion always green -->
                                <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton">
                                        <Setter Property="Background" Value="Green"/>
                                </Style>

                                <!-- nfilled portion always red -->
                                <Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton">
                                        <Setter Property="Background" Value="Red"/>
                                </Style>

                                <!-- keep the filled portion green on hover -->
                                <Style Selector="Slider:horizontal:pointerover /template/ RepeatButton#PART_DecreaseButton">
                                        <Setter Property="Background" Value="Green"/>
                                </Style>

                                <!-- keep the unfilled portion red on hover -->
                                <Style Selector="Slider:horizontal:pointerover /template/ RepeatButton#PART_IncreaseButton">
                                        <Setter Property="Background" Value="Red"/>
                                </Style>

                                <!-- keep both colors when pressed -->
                                <Style Selector="Slider:horizontal:pressed /template/ RepeatButton#PART_DecreaseButton">
                                        <Setter Property="Background" Value="Green"/>
                                </Style>

                                <Style Selector="Slider:horizontal:pressed /template/ RepeatButton#PART_IncreaseButton">
                                        <Setter Property="Background" Value="Red"/>
                                </Style>

                                <!-- customize the track borders -->
                                <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton Border">
                                        <Setter Property="Height" Value="6"/>
                                        <Setter Property="CornerRadius" Value="0"/>
                                </Style>

                                <Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton Border">
                                        <Setter Property="Height" Value="6"/>
                                        <Setter Property="CornerRadius" Value="0"/>
                                </Style>

                                <!-- customize thumb -->
                                <Style Selector="Slider:horizontal /template/ Thumb">
                                        <Setter Property="Height" Value="18"/>
                                        <Setter Property="Width" Value="18"/>
                                        <Setter Property="BorderBrush" Value="White"/>
                                        <Setter Property="BorderThickness" Value="3"/>
                                        <Setter Property="Background" Value="White"/>
                                </Style>

                                <!-- make the thumb darken on hover -->
                                <Style Selector="Slider:horizontal:pointerover /template/ Thumb">
                                        <Setter Property="Background" Value="#c0c0c0"/>
                                        <Setter Property="BorderBrush" Value="#c0c0c0"/>
                                </Style>
                        </Slider.Styles>
                </Slider>

            </StackPanel>

            <!-- Damage -->
            <StackPanel Grid.Column="1" 
                        HorizontalAlignment="Center"
                        Spacing="10">

                <TextBlock Text="Selected Move Damage"
                            FontSize="24"
                            HorizontalAlignment="Center"
                            FontWeight="Bold"/>
                
                <TextBlock Text="(Select a move first)"
                            FontSize="16"
                            HorizontalAlignment="Center"/>
                <!-- There will be multiple numbers displayed because pokemon move damage is randomized to 16 possible values -->

            </StackPanel>

            <!-- Pokemon2 -->
            <!-- Copy and paste the pokemon1 code when it's done (and change variable names ofc) -->
        </Grid>

</Window>