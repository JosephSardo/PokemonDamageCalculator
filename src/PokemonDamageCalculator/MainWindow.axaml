<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PokemonDamageCalculator.MainWindow"
        Title="PokemonDamageCalculator"
        MinWidth="540"
        MinHeight="540"
        CanResize="True"
        WindowState="Maximized">

        <!-- Determine cosmetic gui attributes, like font -->
        <Window.Styles>
                <Style Selector="TextBlock">
                        <Setter Property="FontFamily" 
                                Value="avares://PokemonDamageCalculator/Assets/Fonts#Space Mono"/>
                </Style>

                <Style Selector="TextBox">
                        <Setter Property="FontFamily" 
                                Value="Montserrat"/>
                </Style>

                <Style Selector="Button">
                        <Setter Property="FontFamily" 
                                Value="avares://PokemonDamageCalculator/Assets/Fonts#Space Mono"/>
                </Style>

                <Style Selector="ComboBox">
                        <Setter Property="FontFamily" 
                                Value="avares://PokemonDamageCalculator/Assets/Fonts#Space Mono"/>
                </Style>

                <Style Selector="AutoCompleteBox">
                        <Setter Property="FontFamily" 
                                Value="Montserrat"/>
                </Style>
        </Window.Styles>

        <Grid ColumnDefinitions="*,*,*">

                <!-- Pokemon1 -->
                

                <!-- Damage -->
                <StackPanel Grid.Column="1" 
                                HorizontalAlignment="Center"
                                Spacing="10">

                        <TextBlock Text="Selected Move Damage"
                                FontSize="24"
                                HorizontalAlignment="Center"
                                FontWeight="Bold"/>
                                
                        <TextBlock Text="(Select a move first)"
                                FontSize="16"
                                HorizontalAlignment="Center"/>
                        <!-- There will be multiple numbers displayed because pokemon move damage is randomized to 16 possible values -->

                </StackPanel>

                <!-- Pokemon2 -->
                
        </Grid>
</Window>